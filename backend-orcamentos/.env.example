# Copie para .env nesta pasta. Sem este arquivo (ou sem DATABASE_URL
# definido), o backend cai num SQLite local (geoquote.db) só pra dev/teste —
# ver comentário em main.py. Em produção, as duas variáveis abaixo são
# obrigatórias (rode supabase/schema_contas.sql no projeto Supabase antes).

# Connection string do Postgres do MESMO projeto Supabase usado pro login
# (Project Settings > Database > Connection string > "URI", modo "Session").
# Ex: postgresql+psycopg://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
DATABASE_URL=

# Project Settings > API > JWT Settings > JWT Secret (esquema legado HS256).
# Usado pra validar o token de sessão que o frontend manda em
# Authorization: Bearer <token> — sem isso, toda rota autenticada responde 500.
SUPABASE_JWT_SECRET=
