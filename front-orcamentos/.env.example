# Copie este arquivo para .env e preencha com as credenciais do seu projeto Supabase
# (Project Settings > API no painel do Supabase). O prefixo VITE_ é obrigatório
# para o Vite expor a variável ao código do navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-ANON-KEY-AQUI

# URL base da API do backend. Em dev, deixe vazio (cai no fallback
# http://localhost:8000 embutido no código). Em produção, aponte para o
# caminho servido pelo proxy reverso (ex: /api) — ver docker-compose.yml.
VITE_API_BASE=
