# Usado pelo docker-compose.yml (build args do serviço frontend). Copie
# para .env na raiz do repo e preencha com as mesmas credenciais do
# front-orcamentos/.env.example (Supabase > Project Settings > API).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA-ANON-KEY-AQUI

# Usado pelo docker-compose.yml (variáveis de ambiente do serviço backend).
# Mesmos valores de backend-orcamentos/.env.example.
DATABASE_URL=
SUPABASE_JWT_SECRET=
